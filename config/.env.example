# Copy to the project root as `.env` and adjust. Every key is optional.

# ---- LLM (Llama 3 via Ollama) ----
# auto = use Llama 3 if Ollama is running, else built-in rule-based NLP
LLM_PROVIDER=auto
# LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
LLM_TIMEOUT_SECONDS=60

# ---- Mock core banking API ----
CORE_API_HOST=127.0.0.1
CORE_API_PORT=8001
CORE_API_TIMEOUT_SECONDS=5
CORE_API_MAX_RETRIES=2
# Set e.g. 0.3 to make 30% of core API calls fail with HTTP 503 (chaos test)
CORE_API_FAILURE_RATE=0.0
CORE_API_AUTOSTART=true

# ---- Email input ----
# folder = read .eml files from sample_emails/inbox ; imap = read unseen mails
# Set EMAIL_SOURCE=imap after configuring Gmail IMAP access.
EMAIL_SOURCE=folder
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
# For Gmail, use an app password (not your Google account password).
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# ---- Email output ----
# file = write responses to outbox/ ; smtp = actually send them
SEND_MODE=file
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SUPPORT_FROM_ADDRESS=customer.support@demobank.example

# ---- Processing / audit ----
MAX_PARALLEL_EMAILS=4
DEFAULT_TRANSACTION_COUNT=5
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/email_automation
DATABASE_URL=postgresql+psycopg://postgres:manager@localhost:5432
LOG_LEVEL=INFO
