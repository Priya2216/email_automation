# Copy to the project root as `.env` and adjust. Every key is optional.

# ---- LLM (Llama 3 via Ollama) ----
# auto = use Llama 3 if Ollama is running, else built-in rule-based NLP
LLM_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
LLM_TIMEOUT_SECONDS=60

# ---- Mock core banking API ----
CORE_API_HOST=127.0.0.1
CORE_API_PORT=8001
CORE_API_TIMEOUT_SECONDS=5
CORE_API_MAX_RETRIES=2
# Set e.g. 0.3 to make 30% of core API calls fail with HTTP 503 (chaos test)
CORE_API_FAILURE_RATE=0.0
CORE_API_AUTOSTART=true

# ---- Email input ----
# folder = read .eml files from sample_emails/inbox ; imap = read unseen mails
EMAIL_SOURCE=folder
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# ---- Email output ----
# file = write responses to outbox/ ; smtp = actually send them
SEND_MODE=file
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SUPPORT_FROM_ADDRESS=customer.support@demobank.example

# ---- Processing / audit ----
MAX_PARALLEL_EMAILS=4
DEFAULT_TRANSACTION_COUNT=5
DATABASE_URL=postgresql+psycopg://postgres:manager@localhost:5432/email_automation
LOG_LEVEL=INFO


# --- Confidence scoring + human-in-the-loop approval ---
CONFIDENCE_THRESHOLD=0.65        # replies below this score are held for a human
HUMAN_REVIEW_ENABLED=true
REVIEW_ON_ESCALATION=true        # angry / fraud / legal-threat emails are held for approval
REVIEWER_API_KEY= mysecret123               # when set, review endpoints need header X-Reviewer-Key

# --- RAG policy lookup ---
RAG_EMBEDDING_MODEL=nomic-embed-text   # or bge-m3 (multilingual); empty = BM25 (no model needed)
RAG_MIN_SCORE=0.30

# --- OCR / voice / reply language ---
OCR_LANGUAGES=eng+hin+mar        # only installed Tesseract language packs are used
WHISPER_MODEL=base               # voice channel (pip install -r requirements-voice.txt)
REPLY_LANGUAGE=auto              # auto | en | hi | mr
